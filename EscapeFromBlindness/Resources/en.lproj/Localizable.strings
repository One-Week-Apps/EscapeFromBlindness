/* Voice Over Instructions */
"vo1" = "You are exploring an old tomb. It is dark and you have no torch left: you cannot see anything!\n\nPlease turn on VoiceOver to continue the game!\n\nFirst set up the Accessibility Shortcut, so you can turn VoiceOver on and off easily.\n\nThen go back to the app and turn on VoiceOver.\nDepending on your device, press the side button or the Home button three times.";
"vo2" = "Let's continue exploring !\n\nEnjoy your play !";
"vo_open_settings" = "Open Settings";
"vo_open_settings_error" = "The Settings app could not be opened. Open it yourself, then go to Accessibility and VoiceOver.";

