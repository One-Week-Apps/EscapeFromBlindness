/* Chapter 1 */
"chapter1_description" = "Nepal: year 1976, You approach an ancient ice cave In Nepal. You just reached the summit of the mountain. There is a huge door before of you. When VoiceOver is turned on, you can go from one text to the other by touching it directly or sliding left or right with your finger. Double tap to validate or select something.";

// Level 1
"cq1" = "You are in front of a huge door, what do you do?";
"cq1a1" = "Inspect the surface";
"cq1a2" = "Try to find some opening mechanism on both sides of the door";
"cq1a3" = "Climb the mountain";

// Level 2
"cq2" = "Your walk in an awkward silence; the ground collapses underneath your feet; you just fell into a trap with spikes around you, what do you do?";
"cq2a1" = "Try to climb back";
"cq2a2" = "Wait";
"cq2a3" = "Inspect the spikes";


// Level 3
"cq3" = "You made your way out of the trap; there is a bridge in front of you, a large hole is beneath, what do you do?";
"cq3a1" = "Walk carefully across the bridge";
"cq3a2" = "Try to find another way along the cliff";
"cq3a3" = "Look at the ceiling";

// Level 4
"cq4" = "You managed to reach the other side of the bridge, you look behind and congratulate yourself for your progress; you hear some weird sound, bats are chasing you! What do you do?";
"cq4a1" = "Run as far as you can deeper in the cave";
"cq4a2" = "Try to activate the lever on your right";
"cq4a3" = "Fight the bats with your hat";

//======================================================
/* Chapter 2 */
"chapter2_description" = "After exploring further into the mountain, You reach an old abandonned city which was probably visited by an old Nepalese civilization. There are several doors locked with a lock safe mechanism in front of you. You need to find the code of each of them based on the clues you find in the room. When VoiceOver is turned on, you can use the rotor to access the menu. Draw a circle with two fingers on screen as if you were turning a dial. You can then go from one option to the other. Continue to turn your fingers to hear about answer options, until you hear the option. Drag your finger up or down to validate.";

// Level 1
"chapter2_cq1a1" = "There are bear footprints on the floor";
"chapter2_cq1a2" = "Wolves are standing close to you";
"chapter2_cq1a3" = "There are ice spikes on the ceiling above you";
"chapter2_cq1a4" = "An eagle is on the top of an house of the hidden city";
"chapter2_cq1h1" = "4, 2. Maybe this relates to the number of legs of the animal.";

// Level 2
"chapter2_cq2a1" = "After progressing into the next room, there is a water stream on your left";
"chapter2_cq2a2" = "Birds are singing around you, you find it relaxing";
"chapter2_cq2a3" = "An old owl is standing on the door";

"chapter2_cq2aa1" = "B O W";
"chapter2_cq2aa2" = "B A T";
"chapter2_cq2aa3" = "C A T";
"chapter2_cq2aa4" = "A R R O W";

//======================================================
/* Chapter 3 */
"chapter3_description" = "You successfully went through all the traps of the Lost City, now you reach a gigantic valley; there is a waterfall on the left and something that looks like a temple afar. You meet an old man that tell congratulates you for going so far into the ice cave. He also warns you that, due to some ancient myth, he has to check if you are really the chosen hero, and will have to kill you if you answer wrong to any of its questions!";

// Level 1
"chapter3_q1" = "Hum. What password did you enter in the last room?";
"chapter3_a1" = "bow";

// Level 2
"chapter3_q2" = "Hum. The entrance door of the ice cave. did you open it by pulling the lever on the right of the door?";
"chapter3_a2" = "no";

// Level 3
"chapter3_q3" = "Well done. Let's see. In which country are we located?";
"chapter3_a3" = "nepal";

// Level 4
"chapter3_q4" = "And the last question. Did you fall into some trap during your journey?";
"chapter3_a4" = "yes";

//======================================================
/* Chapter 4 */
"chapter4_description" = "You successfully went through the Hidden Valley, now you reach a stunning ancient tomb; there is a lot of jewelry on the walls and some some coloured tiles on the floor. When VoiceOver is turned on, you can use the rotor to access the Actions menu. Draw a circle with two fingers on screen as if you were turning a dial. You can then go to the Actions option. Drag your finger up or down to select and double tap to validate.";

// Level 1
"chapter4_l1desc" = "You approach the first small room with a lot of jewelry on it, it looks like each of them represents an animal.";

"chapter4_cq1desc" = "A cat is pictured, it looks like a button on the wall, maybe you can press it.";

"chapter4_cq1a1" = "activate it";
"chapter4_cq1a2" = "leave it there";

"chapter4_cq1r1" = "You fall into a trap.";
"chapter4_cq1r2" = "You hear some gear turning noise.";

"chapter4_cq2desc" = "An eagle is pictured, it looks like a button on the wall, maybe you can press it.";

"chapter4_cq3desc" = "A snake is pictured, it looks like a button on the wall, maybe you can press it.";

// Level 2
"chapter4_l2desc" = "You approach the second room with 3 blocks incrusted in the wall. You can probably pull them. A beautiful painting of the mountain is represented on the ceiling.";

"chapter4_cq2desc1" = "The bloc on the left.";

"chapter4_cq2a1" = "leave it there";
"chapter4_cq2a2" = "pull it one time";
"chapter4_cq2a3" = "pull it two times";
"chapter4_cq2a4" = "pull it three times";

"chapter4_cq2r1" = "You fall into a trap.";
"chapter4_cq2r2" = "Nothing happens.";

"chapter4_cq2desc2" = "The bloc in the middle.";

"chapter4_cq2desc3" = "The bloc on the right.";
